      <ColorAnimation Storyboard.TargetName="Ring3" Storyboard.TargetProperty="Color" To="#FF2F6BFF" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Color" To="#FF2F6BFF" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="CoreStop" Storyboard.TargetProperty="Color" To="#FF2F6BFF" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="CoreLight" Storyboard.TargetProperty="Color" To="#FFC2D5FF" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="CoreRing" Storyboard.TargetProperty="Color" To="#FF1E3F99" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="ElectronTint" Storyboard.TargetProperty="Color" To="#FF8FB4FF" Duration="0:0:0.4"/>
      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="28" Duration="0:0:0.4"/>
      <ColorAnimation Storyboard.TargetName="InkA" Storyboard.TargetProperty="Color" To="#FF8FB4FF" Duration="0:0:0.2"/>
