<!--
  atom-console: the atom skin plus a synthetic hexadecimal dump typed over the orbits
  while agents are Busy (royal blue) or need Attention (pulsing gold, twice as fast).
  GENERATED by make_skin.py from ../atom/skin.xaml: edit that script, not this file.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="256" Height="256">
  <Grid.Resources>
    <RadialGradientBrush x:Key="ElectronFill">
      <GradientStop Color="#FFFFFFFF" Offset="0"/>
      <GradientStop x:Name="ElectronTint" Color="#FF9DFFE8" Offset="0.45"/>
      <GradientStop Color="#0039FF14" Offset="1"/>
    </RadialGradientBrush>

    <!-- Runs for the whole life of the skin; the host scales its speed per state. -->
    <Storyboard x:Key="Motion">
      <!-- A half-turn on the second plane keeps the projected heads 120 degrees apart. -->
      <DoubleAnimation Storyboard.TargetName="Spin1" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Spin2" Storyboard.TargetProperty="Angle" From="180" To="540" Duration="0:0:4.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Spin3" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4.2" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Tilt1" Storyboard.TargetProperty="ScaleY" From="0.12" To="0.95" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Tilt2" Storyboard.TargetProperty="ScaleY" From="0.12" To="0.95" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Tilt3" Storyboard.TargetProperty="ScaleY" From="0.12" To="0.95" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="Plane1" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Plane2" Storyboard.TargetProperty="Angle" From="60" To="420" Duration="0:0:24" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="Plane3" Storyboard.TargetProperty="Angle" From="120" To="480" Duration="0:0:24" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.12" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
      <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.12" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
    </Storyboard>

    <!-- State storyboards: Idle has none (base colours). -->
